<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mochi_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Mascot Image -->
    <ImageView
        android:id="@+id/iv_dialog_mascot"
        android:layout_width="95dp"
        android:layout_height="95dp"
        android:scaleType="fitCenter"
        android:src="@drawable/mochi_main" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Welcome to Mochi! 🐾"
        android:textColor="@color/mochi_purple_dark"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="By default, Mochi uses your System Default theme (Light or Dark). Choose your preferred look below:"
        android:textColor="@color/mochi_text_secondary"
        android:textSize="12sp" />

    <!-- 3 Theme Options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <!-- 1. System Default -->
        <Button
            android:id="@+id/btn_choice_system"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_tab_selected"
            android:text="🌓 System Default (Auto Light / Dark)"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 2. Pastel Light -->
        <Button
            android:id="@+id/btn_choice_light"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_mochi_pill"
            android:text="🌸 Pastel Light (Lavender Cream)"
            android:textColor="@color/mochi_purple_dark"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 3. Cozy Dark -->
        <Button
            android:id="@+id/btn_choice_dark"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_mochi_pill"
            android:text="🌙 Cozy Dark (Midnight Violet)"
            android:textColor="@color/mochi_purple_dark"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Dismiss & Start Button -->
    <Button
        android:id="@+id/btn_dialog_confirm"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_mochi_btn"
        android:text="Start Exploring Mochi ✨"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
