<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mochi_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Header Bar with Mochi Mascot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mochi"
                    android:textColor="@color/mochi_purple_dark"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Task Manager 🐾"
                    android:textColor="@color/mochi_purple"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Cute &amp; Powerful System Assistant"
                    android:textColor="@color/mochi_text_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_home_mascot"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="fitCenter"
                android:src="@drawable/mochi_main" />
        </LinearLayout>

        <!-- Device Health Card (Matches Mockup) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_mochi_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❤️ Device Health"
                    android:textColor="@color/mochi_purple_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_home_health_val"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="94/100 Excellent!"
                    android:textColor="@color/mochi_mint"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Health Bar -->
            <ProgressBar
                android:id="@+id/pb_health"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="94"
                android:progressTint="@color/mochi_mint" />
        </LinearLayout>

        <!-- Dynamic Mochi Assistant Message Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_mochi_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:id="@+id/iv_reaction_mascot"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/react_healthy" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_mochi_speech_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mochi says: Healthy! (✿◠‿◠)"
                    android:textColor="@color/mochi_purple_dark"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_mochi_speech_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All systems cool, 13 track/adware removed. Zero lag!"
                    android:textColor="@color/mochi_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 8 Navigation Grid (Matches Mockup) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="SYSTEM TOOLS &amp; MONITORS"
            android:textColor="@color/mochi_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Grid Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- Performance -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_mochi_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📈"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Performance"
                    android:textColor="@color/mochi_purple_dark"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_grid_ram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="75% RAM"
                    android:textColor="@color/mochi_mint"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Processes -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_mochi_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Processes"
                    android:textColor="@color/mochi_purple_dark"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_grid_proc_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 Active"
                    android:textColor="@color/mochi_purple"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Grid Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- Battery -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_mochi_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔋"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Battery"
                    android:textColor="@color/mochi_purple_dark"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_grid_bat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="70% ⚡"
                    android:textColor="@color/mochi_peach"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Device Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_mochi_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Galaxy S21 FE"
                    android:textColor="@color/mochi_purple_dark"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SM-G990E"
                    android:textColor="@color/mochi_cyan"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Live Widget Preview Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="MOCHI WIDGET PREVIEW"
            android:textColor="@color/mochi_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <include
            layout="@layout/widget_cute_terminal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Refresh Action Button -->
        <Button
            android:id="@+id/btn_app_refresh"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_mochi_btn"
            android:text="✨ Boost &amp; Refresh Mochi Monitor"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Permission Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_mochi_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_perm_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔓 Permission: Usage Access Active! (●'◡'●)"
                android:textColor="@color/mochi_mint"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_grant_perm"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_mochi_pill"
                android:text="✓ Permission Granted (Active)"
                android:textColor="@color/mochi_purple"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- How to Add Widget Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_mochi_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📌 How to add Mochi to Home Screen:"
                android:textColor="@color/mochi_purple"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="1. Long-press on an empty spot on your Home Screen\n2. Tap 'Widgets'\n3. Find 'Mochi Task Manager 🐾'\n4. Drag the widget onto your home screen!\n5. Mochi will dynamically react to your phone's battery, temperature and memory!"
                android:textColor="@color/mochi_text_primary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
