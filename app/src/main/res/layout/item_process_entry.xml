<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_mochi_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- App Icon -->
    <ImageView
        android:id="@+id/iv_proc_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:scaleType="fitCenter"
        android:src="@drawable/mochi_main" />

    <!-- App Name & Package -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_proc_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Google Chrome"
            android:textColor="@color/mochi_purple_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_proc_pkg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="com.android.chrome"
            android:textColor="@color/mochi_text_muted"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- CPU % -->
    <TextView
        android:id="@+id/tv_proc_cpu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="4.2%"
        android:textColor="@color/mochi_pink"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- RAM MB -->
    <TextView
        android:id="@+id/tv_proc_mem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="512 MB"
        android:textColor="@color/mochi_cyan"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
